# Copia este archivo como .env.local para probar en tu computador.
# En Vercel se cargan en Settings > Environment Variables (ver README).

# Enlace de "Publicar en la web" de la pestaña de productos, en formato CSV
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/TU_ENLACE_PUBLICADO/pub?gid=0&single=true&output=csv

# Opcional: enlace CSV de la pestaña "categorias"
SHEET_CATEGORIAS_CSV_URL=

# WhatsApp de la tienda que recibe los pedidos (con código de país)
WHATSAPP_TIENDA=+56 9 5417 9298

# Tu dominio con https:// y sin / final (en local se deja vacío)
SITE_URL=

# Mercado Pago: Access Token (de prueba o de producción) y clave secreta de los webhooks
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Apps Script de la planilla (docs/apps-script.gs): URL /exec y la clave que pusiste en el script
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=
